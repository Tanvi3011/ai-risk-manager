# LLM Configuration (optional — system works offline without this)
# Set LLM_PROVIDER to "groq" or "openai"
# The LLM powers the Critic, Explainer, and Case Q&A agents

# Option 1: Groq (free tier available, fast inference)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Option 2: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
